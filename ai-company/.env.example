# MODELE de configuration — COPIER en .env (jamais commite) et remplir.
# NE JAMAIS mettre de vraie cle / mot de passe ici : ce fichier est versionne.

# ================== AWS BEDROCK (modeles LLM) ==================
# ID = inference profile Bedrock (depend region/compte). Lister :
#   aws bedrock list-inference-profiles --region us-east-1
#   aws bedrock list-foundation-models --region us-east-1
# ATTENTION au prefixe de profil d'inference : `amazon.nova-2-lite-v1:0` est REFUSE
# (ValidationException), `us.amazon.nova-2-lite-v1:0` passe. VERIFIER l'ID exact avec
#    aws bedrock list-inference-profiles --region us-east-1
# Nova 2 Lite (rapide, pas cher, tool calling OK) : us.amazon.nova-2-lite-v1:0
# Nova Pro (plus profond, roles lourds)           : us.amazon.nova-pro-v1:0
# Claude Sonnet (tool calling)                    : us.anthropic.claude-sonnet-4-5-20250929-v1:0
# DeepSeek V3/R1 : pas de tool calling -> mode JSON automatique
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
# AUTH : soit la chaine boto3 (AWS_PROFILE / cles / role IAM), soit une CLE API Bedrock.
BEDROCK_API_KEY=<votre_cle_api_bedrock>
# AWS_PROFILE=default
# auto = outils si le modele sait, sinon JSON | tools = force | json = force
BEDROCK_TOOL_MODE=auto
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2000
AGENT_MAX_STEPS=24               # nb max d'appels d'outils par cycle (mode outils)

# ================== MT5 ==================
MT5_LOGIN=<numero_de_compte>
MT5_PASSWORD=<mot_de_passe>
MT5_SERVER=<serveur_broker>      # ex FTMO-Demo
# MT5_PATH=C:\Program Files\FTMO MetaTrader 5\terminal64.exe   # optionnel

# ================== CHASSIS FTMO 2 ETAPES ==================
FTMO_ACCOUNT_SIZE=100000
FTMO_PHASE=1              # 1 = Challenge (+10%) | 2 = Verification (+5%)
FTMO_PHASE1_TARGET_PCT=10
FTMO_PHASE2_TARGET_PCT=5
FTMO_MAX_DAILY_LOSS_PCT=5
FTMO_MAX_TOTAL_LOSS_PCT=10
FTMO_PHASE_DAYS=30
FTMO_MIN_TRADING_DAYS=4
# FTMO_PHASE_START=2026-08-11   # optionnel : date de debut d'etape (sinon 1er run)

# ================== GARDE-FOUS AGENT (plus stricts que FTMO) ==================
AGENT_RISK_PER_TRADE_PCT=1.0     # 1% du solde / trade
AGENT_DAILY_STOP_PCT=4           # stop ouvertures a -4% (marge avant le -5% fatal)
AGENT_TOTAL_SOFT_STOP_PCT=7
AGENT_MAX_OPEN_POSITIONS=3       # 2-3 max
AGENT_MAX_TRADES_PER_DAY=3
AGENT_MAX_RISK_PER_SYMBOL_PCT=1.0
AGENT_COOLDOWN_MIN=120

# ================== SWING (tenue plusieurs jours) ==================
AGENT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD   # watchlist de depart (pas une limite)
AGENT_TIMEFRAME=D1
AGENT_CHART_TFS=W1,D1,H4         # timeframes pre-charges du chart
AGENT_LOOP_SECONDS=3600

# ================== COUTS ET EXECUTION (a caler sur VOTRE broker) ==================
AGENT_COMMISSION_PER_LOT=7       # commission ALLER-RETOUR par lot (FTMO FX ~ 3$/cote)
AGENT_SLIPPAGE_PIPS=1.0          # provision de derapage (entree + sortie)
AGENT_MAX_SPREAD_PIPS=3.0        # au-dela : pas d'entree
AGENT_MAX_SPREAD_ATR=0.12        # spread max en fraction de l'ATR
AGENT_DEVIATION_POINTS=20
AGENT_ORDER_RETRIES=2            # tentatives supplementaires sur requote
AGENT_MAX_MARGIN_PCT=20          # % max de la marge libre engagee par position
AGENT_WEEKEND_GUARD=1            # pas d'ouverture avant la fermeture hebdo (gap)
AGENT_FRIDAY_CUTOFF_UTC=20       # heure SERVEUR (EET/EEST), pas UTC local
AGENT_GAP_PROVISION_ATR=1.0
AGENT_WEEKEND_FLATTEN=0          # 1 = fermer TOUTES les positions au cutoff du vendredi
# Les ordres partent AU MARCHE : le niveau d'entree annonce par le LLM ne sert qu'au
# sizing. S'il est loin du prix reel, le lot et le R:R calcules sont des fictions.
AGENT_ENTRY_REPRICE=1            # recaler l'entree sur le prix executable avant le sizing
AGENT_MAX_ENTRY_DRIFT_ATR=0.5    # au-dela de N x ATR d'ecart : entree refusee

# ================== GARDE-FOUS DE SECURITE (revue de risque) ==================
AGENT_WATCH_SECONDS=60           # watchdog deterministe entre deux cycles LLM
AGENT_MAX_RISK_PER_CURRENCY_PCT=2.0   # plafond de risque correle par devise
AGENT_MAGIC=770077               # signature des ordres de l'agent
AGENT_OWN_POSITIONS_ONLY=1       # ne JAMAIS toucher aux positions d'un autre EA

# ================== PILOTE DE SECOURS (si l'IA tombe) ==================
SAFE_BE_AT_R=1.0                 # stop au break-even des +1R
SAFE_TRAIL_ATR=2.0
SAFE_TRAIL_ACTIVATE_R=1.0
SAFE_MISSING_SL_ATR=1.5          # SL d'urgence si une position n'a pas de stop
SAFE_TIME_STOP_DAYS=10
SAFE_TIME_STOP_MIN_R=0.3
SAFE_PANIC_RATIO=0.75            # fraction du stop jour -> fermeture totale
SAFE_EXIT_WHEN_FLAT=1            # arret du script une fois le book vide

# ================== NEWS (calendrier WEB + FRED + biais macro) ==================
# Le calendrier vient du flux faireconomy (miroir ForexFactory), la meme source que la
# regle news FTMO : aucun terminal MT5, aucun CSV a exporter, rien qui puisse perimer.
NEWS_ENABLED=1
FRED_API=<votre_cle_fred>        # https://fred.stlouisfed.org/docs/api/api_key.html
# FRED porte tout le biais macro : une serie de taux par devise, et pour l'OR le trio
# DFII10 (taux reels) / DTWEXBGS (dollar) / T10YIE (inflation anticipee). Sans cette cle,
# le biais macro est vide — c'est la cle la plus structurante du fichier.
NEWS_BLACKOUT_MIN=60      # pas d'entree si annonce fort impact dans +/- N minutes
NEWS_RECENT_HOURS=72
NEWS_UPCOMING_HOURS=72
NEWS_CACHE_MIN=30
NEWS_MIN_IMPORTANCE=2     # 2=moyen, 3=fort
NEWS_FAIL_CLOSED=0        # 1 = aucune entree si le calendrier economique est illisible

# ================== RECHERCHE WEB (analyse macro / expert) ==================
WEB_ENABLED=1
WEB_MAX_CALLS=12          # budget de requetes web par cycle (partage seq. + parallele)
WEB_MAX_PARALLEL=3        # appels web menes de front (web_search_multiple / web_read_multiple)
WEB_MAX_CHARS=6000        # texte extrait par page
WEB_TIMEOUT=20
WEB_CACHE_MIN=20
# WEB_ALLOW_DOMAINS=federalreserve.gov,ecb.europa.eu   # vide = tout autorise
# WEB_DENY_DOMAINS=
# MYFXBOOK_EMAIL=<email>  # sentiment retail via l'API officielle myfxbook
# MYFXBOOK_PASSWORD=<mot_de_passe>

# ================== NOTIFICATIONS EMAIL ==================
MAIL_ENABLED=1
MAIL_TO=<votre_adresse@exemple.com>     # plusieurs destinataires : separes par des virgules
MAIL_HOST=<smtp.exemple.com>
MAIL_PORT=465                           # 465 = SSL, 587 = STARTTLS
MAIL_SECURE=ssl                         # ssl | tls | none (deduit du port si vide)
MAIL_USER=<compte_smtp>
MAIL_PASSWORD=<mot_de_passe_smtp>
MAIL_FROM="Agent FTMO <no-reply@exemple.com>"
MAIL_ON_TRADE=1          # ouverture / cloture de position
MAIL_ON_ALERT=1          # IA indisponible, urgence FTMO, arret du script
MAIL_TIMEOUT=20

# ================== ENTREPRISE D'AGENTS (desk/) ==================
# Le cerveau n'est pas un LLM unique mais une ENTREPRISE de roles :
# Gerant -> 4 analystes independants -> debat Bull/Bear arbitre par un juge -> Trader
# -> college du risque (agressif/neutre/prudent) arbitre par le DG -> moteur FTMO.
# Le moteur FTMO deterministe reste le PLANCHER : aucune couche LLM ne peut desserrer.
AGENT_MODE=desk           # desk = entreprise multi-agents ; solo = agent unique (repli)
DESK_MAX_CANDIDATS=2      # symboles etudies a fond par cycle (borne le cout LLM)
DESK_USE_ANALYSTS=1       # 4 analystes (technique, fondamental, sentiment, actualite)
DESK_USE_DEBATE=1         # debat Bull/Bear + juge (son verdict s'impose au Trader)
DESK_DEBATE_ROUNDS=2      # MAXIMUM de tours ; le 2e n'a lieu que si le debat est serre
DESK_DEBATE_GAP=0.2       # ecart de conviction en dessous duquel le debat est dit "serre"
DESK_RISK_DEBATE=1        # 0 = Risk Manager mono-voix a la place du college
DESK_MAX_TOKENS=1500
DESK_TEMPERATURE=0.2
# VIGIE : surveille les positions ENTRE deux cycles et peut faire convoquer une session
# extraordinaire (qui ne peut que REDUIRE le risque). Declencheurs deterministes only.
DESK_VIGIE_ENABLED=1
DESK_VIGIE_ALERT_R=-0.6        # perte flottante (en R) qui reveille la vigie
DESK_VIGIE_GIVEBACK_R=1.0      # MFE atteint au-dela duquel "gains rendus" alerte
DESK_VIGIE_MIN_MINUTES=30      # anti-spam : delai min entre deux consultations d'un ticket
# Modeles a deux vitesses (vides = modele unique BEDROCK_MODEL_ID partout).
# Payer un gros modele pour dire "rien a signaler" 24 fois par jour n'a aucun sens.
# DESK_MODEL_RAPIDE=<modele rapide>   # Gerant, Trade Manager, Vigie (a chaque cycle)
# DESK_MODEL_FORT=<modele fort>       # Trader, analystes, debat, risque (rares, lourds)
# DESK_MODEL_GERANT= / _TRADER= / _RISK= / _ANALYSTE= / _DEBAT= / _SUIVI= / _VIGIE=
# --- Emprunts cibles a TradingAgents (tous OPT-IN, fail-closed) ---
DESK_TRACE=1              # journalise chaque appel LLM du desk (state/traces/<cycle>.jsonl)
DESK_CHECKPOINT=1         # reprise d'un cycle interrompu (cle deterministe + TTL court)
DESK_REFLEXION=1          # note factuelle bornee a la cloture, injectee par proximite
DESK_REFLEXION_K=3        # nb de reflexions passees les plus proches donnees au Trader
DESK_ANALYSTES_OUTILS=0   # analystes tool-capables (ReAct) — seulement si modele capable
DESK_ANALYSTES_OUTILS_ITER=3
DESK_SENTIMENT_SOCIAL=0   # sentiment social pour l'analyste Sentiment (donnee NON fiable)

# ================== SOURCES PLUGGABLES (data/sources.py) ==================
# Marche / Social / News / Fondamentaux. Rien d'actif par defaut : chaque source s'allume
# avec sa cle ou son drapeau ; tout texte externe est assaini (anti-injection de prompt).
SOURCES_RSS=              # flux RSS/Atom (Reuters, banques centrales...), separes par des ,
SOURCES_FUNDAMENTALS=1    # injecter les fondamentaux dans l'analyste Fondamental (si source active)
SOURCES_NEWS=1            # injecter les titres des sources dans l'analyste Actualite
# RETIRES le 2026-08-19, apres mesure : GDELT (429 a 1 req/5 s, ~43 s par cycle, titres hors
# sujet malgre sourcelang=english), Finnhub et EODHD (403 : donnees ACTIONS, calendrier payant).
# Une cle qui ne rend rien est pire qu'une source absente : elle fait croire la colonne couverte.
# Non branches (pas d'API libre) : X/Twitter, Yahoo Finance, Bloomberg/Reuters (passer par RSS).

# ================== SIMULATEUR MONTE-CARLO (risk/montecarlo.py) ==================
# Probabilite de PASSAGE du challenge avant d'acheter un compte. Pas de variable d'env :
#   python -m risk.montecarlo --history                       # calibre sur tes trades clotures
#   python -m risk.montecarlo --win-rate 0.45 --win-r 2 --loss-r -1
#   python -m risk.montecarlo --risk 3 --max-trades 5 --stress 0.15   # analyse de sensibilite

# ================== MESURE / REJEU (desk/replay.py) ==================
# Sans instrument de mesure, ajouter des agents augmente la variance, pas la qualite.
EVAL_JOURNAL_CYCLES=1     # archive le dossier d'entree + le plan de chaque cycle (rejouable)
EVAL_JOURNAL_KEEP=500     # rotation : nb de cycles conserves en base
EVAL_SHADOW=0             # 1 = MODE OMBRE : le cerveau decide, RIEN n'est execute
EVAL_REPLAY_MAX_BARS=30   # bougies parcourues en aval d'une decision pour simuler son issue
# Rapport : python desk/replay.py [--shadow] [--roles] [--cout-r 0.05]

# ================== ETAT PERSISTANT ==================
# Defaut : ./state/agent.db (dans ce dossier). AGENT_STATE_DIR deplace tout l'etat
# (utile si le code est en lecture seule) ; AGENT_DB force le seul fichier de base.
# AGENT_STATE_DIR=/var/lib/ai-company
# AGENT_DB=C:\chemin\vers\agent.db

# ================== EXECUTION ==================
# L'agent passe TOUJOURS des ordres REELS via MT5. Il n'y a plus de mode dry-run.
