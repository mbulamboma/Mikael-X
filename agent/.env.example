# MODELE de configuration — COPIER en .env (jamais commite) et remplir.
# NE JAMAIS mettre de vraie cle / mot de passe ici : ce fichier est versionne.

# ================== AWS BEDROCK (modeles LLM) ==================
# ID = inference profile Bedrock (depend region/compte). Lister :
#   aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1
# Credentials : chaine boto3 par defaut (AWS_PROFILE, AWS_ACCESS_KEY_ID/SECRET, role IAM)
# AWS_PROFILE=default
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2000
AGENT_MAX_STEPS=24               # nb max d'appels d'outils par cycle

# ================== MT5 ==================
MT5_LOGIN=<numero_de_compte>
MT5_PASSWORD=<mot_de_passe>
MT5_SERVER=<serveur_broker>      # ex FTMO-Demo
# MT5_PATH=C:\Program Files\FTMO MetaTrader 5\terminal64.exe   # optionnel
# MT5_FILES=C:\Users\...\MQL5\Files   # optionnel (auto-detecte) : calendrier / macro

# ================== CHASSIS FTMO 2 ETAPES ==================
FTMO_ACCOUNT_SIZE=100000
FTMO_PHASE=1              # 1 = Challenge (+10%) | 2 = Verification (+5%)
FTMO_PHASE1_TARGET_PCT=10
FTMO_PHASE2_TARGET_PCT=5
FTMO_MAX_DAILY_LOSS_PCT=5
FTMO_MAX_TOTAL_LOSS_PCT=10
FTMO_PHASE_DAYS=30
FTMO_MIN_TRADING_DAYS=4
# FTMO_PHASE_START=2026-08-11   # optionnel : date de debut d'etape (sinon 1er run)

# ================== GARDE-FOUS AGENT (plus stricts que FTMO) ==================
AGENT_RISK_PER_TRADE_PCT=1.0     # 1% du solde / trade
AGENT_DAILY_STOP_PCT=4           # stop ouvertures a -4% (marge avant le -5% fatal)
AGENT_TOTAL_SOFT_STOP_PCT=7
AGENT_MAX_OPEN_POSITIONS=3       # 2-3 max
AGENT_MAX_TRADES_PER_DAY=3
AGENT_MAX_RISK_PER_SYMBOL_PCT=1.0
AGENT_COOLDOWN_MIN=120

# ================== SWING (tenue plusieurs jours) ==================
AGENT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD   # watchlist de depart (pas une limite)
AGENT_TIMEFRAME=D1
AGENT_CHART_TFS=W1,D1,H4         # timeframes pre-charges du chart
AGENT_LOOP_SECONDS=3600

# ================== COUTS ET EXECUTION (a caler sur VOTRE broker) ==================
AGENT_COMMISSION_PER_LOT=7       # commission ALLER-RETOUR par lot (FTMO FX ~ 3$/cote)
AGENT_SLIPPAGE_PIPS=1.0          # provision de derapage (entree + sortie)
AGENT_MAX_SPREAD_PIPS=3.0        # au-dela : pas d'entree
AGENT_MAX_SPREAD_ATR=0.12        # spread max en fraction de l'ATR
AGENT_DEVIATION_POINTS=20
AGENT_ORDER_RETRIES=2            # tentatives supplementaires sur requote
AGENT_MAX_MARGIN_PCT=20          # % max de la marge libre engagee par position
AGENT_WEEKEND_GUARD=1            # pas d'ouverture avant la fermeture hebdo (gap)
AGENT_FRIDAY_CUTOFF_UTC=20
AGENT_GAP_PROVISION_ATR=1.0

# ================== PILOTE DE SECOURS (si l'IA tombe) ==================
SAFE_BE_AT_R=1.0                 # stop au break-even des +1R
SAFE_TRAIL_ATR=2.0
SAFE_TRAIL_ACTIVATE_R=1.0
SAFE_MISSING_SL_ATR=1.5          # SL d'urgence si une position n'a pas de stop
SAFE_TIME_STOP_DAYS=10
SAFE_TIME_STOP_MIN_R=0.3
SAFE_PANIC_RATIO=0.75            # fraction du stop jour -> fermeture totale
SAFE_EXIT_WHEN_FLAT=1            # arret du script une fois le book vide

# ================== NEWS (calendrier MT5 + FRED + GDELT + macro) ==================
NEWS_ENABLED=1
FRED_API=<votre_cle_fred>        # https://fred.stlouisfed.org/docs/api/api_key.html
NEWS_GDELT=1
NEWS_BLACKOUT_MIN=60      # pas d'entree si annonce fort impact dans +/- N minutes
NEWS_RECENT_HOURS=72
NEWS_UPCOMING_HOURS=72
NEWS_CACHE_MIN=30
NEWS_MIN_IMPORTANCE=2     # 2=moyen, 3=fort

# ================== RECHERCHE WEB (analyse macro / expert) ==================
WEB_ENABLED=1
WEB_MAX_CALLS=12          # budget de requetes web par cycle
WEB_MAX_CHARS=6000        # texte extrait par page
WEB_TIMEOUT=20
WEB_CACHE_MIN=20
# WEB_ALLOW_DOMAINS=federalreserve.gov,ecb.europa.eu   # vide = tout autorise
# WEB_DENY_DOMAINS=
# GOOGLE_API_KEY=<cle>    # Google Custom Search (sinon repli DuckDuckGo)
# GOOGLE_CSE_ID=<id>
# MYFXBOOK_EMAIL=<email>  # sentiment retail via l'API officielle myfxbook
# MYFXBOOK_PASSWORD=<mot_de_passe>

# ================== ETAT PERSISTANT ==================
# AGENT_DB=C:\chemin\vers\agent.db   # defaut : agent/state/agent.db

# ================== EXECUTION ==================
# L'agent passe TOUJOURS des ordres REELS via MT5. Il n'y a plus de mode dry-run.
